# Backend API (the deployed Express API, with /api/v1 at the end)
BACKEND_API_URL=https://university-org-management-backend.vercel.app/api/v1

# Optional but recommended: the SAME secrets as the backend.
# They let the proxy verify the login tokens locally. Never prefix them with NEXT_PUBLIC_.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Optional: Google login button (OAuth Web client id). Leave empty to hide the button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
